# Supabase (https://app.supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Supabase direct Postgres password (NOT the anon/service-role key).
# Required by scripts/verify_migration_003.py (D-15 exit gate).
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string → password
SUPABASE_DB_PASSWORD=

# API-Football Pro Plan (https://dashboard.api-football.com)
API_FOOTBALL_KEY=your-api-football-key

# The Odds API Rookie Plan (https://the-odds-api.com)
ODDS_API_KEY=your-odds-api-key

# ─────────────────────────────────────────────────────
# Phase 3: Pick Engine + Delivery + Account Protection
# ─────────────────────────────────────────────────────

# Telegram bot (D-13). Create via @BotFather.
# Channel ID format: must start with -100 (Pitfall 8).
# Derive channel ID by forwarding any channel message to @userinfobot.
# Promoted from Phase 1 -- now required for delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100

# Anthropic API for Claude Role C validator (D-05, D-06).
# Provision at https://console.anthropic.com (fund $20 minimum credit).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Account longevity (PICK-02 / D-10).
# 0.25 = quarter Kelly. Lower for paranoia, NEVER higher.
MAX_KELLY_FRACTION=0.25
